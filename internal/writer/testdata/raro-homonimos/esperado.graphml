    <node id="n7"><data key="label">li</data><data key="kind">element</data></node>
    <node id="n8"><data key="label">p</data><data key="kind">element</data></node>
    <node id="n9"><data key="label">p</data><data key="kind">text</data></node>
    <node id="n10"><data key="label">p</data><data key="kind">element</data></node>
    <node id="n11"><data key="label">li</data><data key="kind">text</data></node>
    <edge source="n0" target="n1"/>
    <edge source="n1" target="n2"/>
    <edge source="n0" target="n3"/>
