  <key id="label" for="node" attr.name="label" attr.type="string"/>
  <key id="kind" for="node" attr.name="kind" attr.type="string"/>
  <graph id="html2graph" edgedefault="directed">
    <node id="n0"><data key="label">ul</data><data key="kind">element</data></node>
    <node id="n1"><data key="label">li</data><data key="kind">element</data></node>
    <node id="n2"><data key="label">x</data><data key="kind">text</data></node>
