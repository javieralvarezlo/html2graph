<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://gexf.net/1.3 http://gexf.net/1.3/gexf.xsd" version="1.3">
  <meta>
    <creator>html2graph</creator>
  </meta>
  <graph mode="static" defaultedgetype="directed">
    <attributes class="node">
      <attribute id="kind" title="kind" type="string"/>
    </attributes>
    <nodes>
      <node id="n0" label="ul"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n1" label="li"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n2" label="x"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
      <node id="n3" label="li"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n4" label="x"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
      <node id="n5" label="li"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n6" label="x"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
      <node id="n7" label="li"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n8" label="p"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n9" label="p"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
      <node id="n10" label="p"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n11" label="li"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
    </nodes>
    <edges>
      <edge id="e0" source="n0" target="n1"/>
      <edge id="e1" source="n1" target="n2"/>
      <edge id="e2" source="n0" target="n3"/>
      <edge id="e3" source="n3" target="n4"/>
      <edge id="e4" source="n0" target="n5"/>
      <edge id="e5" source="n5" target="n6"/>
      <edge id="e6" source="n0" target="n7"/>
      <edge id="e7" source="n7" target="n8"/>
      <edge id="e8" source="n8" target="n9"/>
      <edge id="e9" source="n7" target="n10"/>
      <edge id="e10" source="n10" target="n11"/>
    </edges>
  </graph>
</gexf>
