    <nodes>
      <node id="n0" label="div"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n1" label="p"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n2" label="Este es un párrafo deliberadamente largo, sin ningún salto de línea, para ver cómo dibuja cada herramienta una etiqueta de varios cientos de caracteres: Graphviz no parte las etiquetas, así que el rectángulo del nodo se estira a lo ancho hasta ocupar toda la imagen, y Gephi o yEd la escriben en una sola línea que tapa a los nodos vecinos."><attvalues><attvalue for="kind" value="text"/></attvalues></node>
      <node id="n3" label="input type=&quot;text&quot; id=&quot;buscar&quot; name=&quot;q&quot; value=&quot;&quot; placeholder=&quot;Buscar...&quot; maxlength=&quot;80&quot; size=&quot;40&quot; autocomplete=&quot;off&quot; spellcheck=&quot;false&quot; required=&quot;&quot; disabled=&quot;&quot;"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n4" label="div"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
