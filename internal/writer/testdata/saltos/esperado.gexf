<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://gexf.net/1.3 http://gexf.net/1.3/gexf.xsd" version="1.3">
  <meta>
    <creator>html2graph</creator>
  </meta>
  <graph mode="static" defaultedgetype="directed">
    <attributes class="node">
      <attribute id="kind" title="kind" type="string"/>
    </attributes>
    <nodes>
      <node id="n0" label="pre title=&quot;línea 1&#10;línea 2&quot;"><attvalues><attvalue for="kind" value="element"/></attvalues></node>
      <node id="n1" label="uno&#10;dos"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
      <node id="n2" label="tres&#13;&#10;cuatro"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
      <node id="n3" label="cinco&#13;seis"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
      <node id="n4" label="siete&#9;ocho"><attvalues><attvalue for="kind" value="text"/></attvalues></node>
    </nodes>
    <edges>
      <edge id="e0" source="n0" target="n1"/>
      <edge id="e1" source="n0" target="n2"/>
      <edge id="e2" source="n0" target="n3"/>
      <edge id="e3" source="n0" target="n4"/>
    </edges>
  </graph>
</gexf>
